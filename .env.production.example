# Remplacer chaque valeur avant de démarrer le service en mode production.
PADDLE_CLIENT_TOKEN=live_remplacer
PADDLE_PRICE_ID=pri_remplacer
PADDLE_PRODUCT_ID=pro_remplacer

# Secrets réservés au service commercial, jamais au bundle Vite.
PADDLE_WEBHOOK_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
PREMIUM_RECEIPT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nremplacer\n-----END PRIVATE KEY-----
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
COMMERCIAL_DATABASE_PATH=/var/lib/lanternes/commercial.sqlite
EMAIL_DELIVERY_URL=https://email.example.test/send
EMAIL_DELIVERY_TOKEN=remplacer-par-le-jeton-du-service-email

# Origine HTTPS publique et clé Ed25519 associée à la clé privée ci-dessus.
COMMERCIAL_ORIGIN=https://jeu.example.test
VITE_PREMIUM_RECEIPT_PUBLIC_KEY=remplacer-par-la-cle-publique-spki-en-base64
