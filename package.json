{
  "name": "lanternes-de-cendre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:compile": "tsx scripts/compiler-contenu.ts",
    "dev": "npm run content:compile && vite",
    "build:app": "npm run content:compile && tsc -b && vite build",
    "build": "npm run build:app && npm run budgets:check",
    "typecheck": "npm run content:compile && tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run content:compile && vitest run",
    "test:e2e": "npm run content:compile && playwright test",
    "scenarios:check": "tsx scripts/scenarios-sentinelles.ts",
    "equilibrage:check": "tsx scripts/equilibrage-campagne.ts --graines 256 --comparer-version-precedente --resume artifacts/equilibrage/standard.json",
    "equilibrage:nightly": "tsx scripts/equilibrage-campagne.ts --nocturne --resume artifacts/equilibrage/nocturne.json",
    "test:bundle-boundary": "tsx scripts/verifier-frontiere-premium.ts",
    "budgets:check": "tsx scripts/budgets-campagne.ts",
    "performance:check": "tsx scripts/performance-campagne.ts",
    "sprites:draft": "tsx scripts/sprites/cli.ts draft",
    "sprites:ingest": "tsx scripts/sprites/cli.ts ingest",
    "sprites:process": "tsx scripts/sprites/cli.ts process",
    "sprites:preview": "tsx scripts/sprites/cli.ts preview",
    "sprites:publish": "tsx scripts/sprites/cli.ts publish",
    "sprites:check": "tsx scripts/sprites/cli.ts check",
    "check": "npm run typecheck && npm run lint && npm run sprites:check && npm run test && npm run scenarios:check && npm run equilibrage:check && npm run test:e2e && npm run build && npm run performance:check && npm run test:bundle-boundary"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@paddle/paddle-js": "^1.6.4",
    "better-auth": "^1.6.24",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "openai": "^6.48.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
