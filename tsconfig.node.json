{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "serveur-commercial/**/*.ts",
    "src/content/compiler.ts",
    "src/content/texte.ts",
    "src/content/types.ts",
    "src/commercial/recu.ts",
    "src/vite-env.d.ts"
  ]
}
